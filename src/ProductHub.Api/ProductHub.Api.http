@ProductHub.Api_HostAddress = http://localhost:5099

POST {{ProductHub.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "sku": "BOTTLE-750",
  "name": "Trail Bottle",
  "brand": "Northwind",
  "attributes": [
    { "name": "Volume", "value": "750", "unit": "ml" }
  ]
}

###

GET {{ProductHub.Api_HostAddress}}/api/products?page=1&pageSize=20
Accept: application/json

### Generate after replacing the product id

POST {{ProductHub.Api_HostAddress}}/api/products/00000000-0000-0000-0000-000000000000/drafts/generate
Content-Type: application/json
Idempotency-Key: manual-generation-1

{
  "language": "de"
}

###
### Advanced RAG without structured facts (sign in as administrator first; replace product id)
POST {{ProductHub.Api_HostAddress}}/api/products/00000000-0000-0000-0000-000000000000/drafts/generate
Content-Type: application/json
Idempotency-Key: advanced-no-facts-1

{
  "language": "en",
  "includeFacts": false,
  "retrievalMode": "Advanced",
  "topK": 5,
  "model": "qwen3:8b"
}

### Naive RAG with product facts (requires indexed product knowledge)
POST {{ProductHub.Api_HostAddress}}/api/products/00000000-0000-0000-0000-000000000000/drafts/generate
Content-Type: application/json
Idempotency-Key: naive-with-facts-1

{
  "language": "de",
  "includeFacts": true,
  "retrievalMode": "Naive",
  "topK": 5
}

### Identity only: no structured facts and no retrieval
POST {{ProductHub.Api_HostAddress}}/api/products/00000000-0000-0000-0000-000000000000/drafts/generate
Content-Type: application/json
Idempotency-Key: identity-only-1

{
  "language": "en",
  "includeFacts": false,
  "retrievalMode": "None"
}

### Invalid retrieval selection: HTTP 400
POST {{ProductHub.Api_HostAddress}}/api/products/00000000-0000-0000-0000-000000000000/drafts/generate
Content-Type: application/json
Idempotency-Key: invalid-rag-1

{
  "retrievalMode": "Unknown"
}
